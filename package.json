{
  "name": "n8n-nodes-safepal",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for SafePal hardware wallet integration providing 25 resources and 200+ operations for multi-chain cryptocurrency management. Includes QR code workflows, Bluetooth connectivity, WalletConnect, and support for 54+ blockchain networks.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-safepal.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-safepal#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-safepal/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "safepal",
    "hardware-wallet",
    "cryptocurrency",
    "blockchain",
    "bitcoin",
    "ethereum",
    "solana",
    "cosmos",
    "multi-chain",
    "qr-code",
    "air-gapped",
    "walletconnect",
    "web3"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.md",
    "LICENSING_FAQ.md",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SafePalDeviceCredentials.credentials.js",
      "dist/credentials/SafePalAppCredentials.credentials.js",
      "dist/credentials/SafePalNetworkCredentials.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SafePal/SafePal.node.js",
      "dist/nodes/SafePal/SafePalTrigger.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.3",
    "@noble/secp256k1": "^2.0.0",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bs58": "^5.0.0",
    "bs58check": "^3.0.1",
    "buffer": "^6.0.3",
    "ethers": "^6.9.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "1.57.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}